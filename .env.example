# Token partagé entre le relais et les extensions : 64 caractères hex aléatoires (openssl rand -hex 32)
RELAY_TOKEN=remplace-moi-par-la-sortie-de-openssl-rand-hex-32
# Port publié sur la machine (exotique pour éviter les conflits)
RELAY_PORT=47821
# Adresse d'écoute : 127.0.0.1 (reverse proxy local, recommandé) ou 0.0.0.0
RELAY_BIND=127.0.0.1
