# Dans le bloc server { listen 443 ssl; server_name remote.ton-domaine.fr; ... } existant :
location /claude-remote/ {
    proxy_pass http://127.0.0.1:47821/;         # le "/" final retire le préfixe -> /ws
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 3600s;                    # connexions WebSocket longues
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
# URL à mettre dans l'extension : wss://remote.ton-domaine.fr/claude-remote/ws
